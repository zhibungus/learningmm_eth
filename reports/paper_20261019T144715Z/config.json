      "report_latency_ms": null,
      "order_jitter_ms": 0.0,
      "feed_jitter_ms": 0.0,
      "timer_interval_ms": 1000
    },
    "fill_model": {
      "type": "l2",
      "require_trade_through": false,
      "cancel_assumption": "proportional",
      "initial_queue_factor": 1.0,
      "sweep_penalty_ticks": 1
