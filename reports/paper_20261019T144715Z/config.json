          }
        },
        "higher_latency": {
          "latency": {
            "feed_latency_ms": 100.0,
            "order_latency_ms": 200.0
          }
        },
        "pessimistic_all": {
          "fill_model": {
            "require_trade_through": true,
            "cancel_assumption": "all_behind",
            "initial_queue_factor": 1.5
          },
          "latency": {
            "feed_latency_ms": 100.0,
            "order_latency_ms": 200.0
          }
        }
      }
    },
    "paper": {
      "log_interval_s": 10,
      "heartbeat_s": 1
    }
  },
  "meta": {
    "mode": "paper",
    "command": "python -m mm.paper.run --config config\\paper\\demo_paper.yaml --duration 60",
    "feed_drops": 0,
    "notes": [
      "PAPER RUN: live public data, simulated exchange; no real orders were sent.",
